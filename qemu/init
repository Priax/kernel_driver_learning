#!/bin/busybox sh
/bin/busybox --install -s /bin
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mount -t debugfs none /sys/kernel/debug 2>/dev/null
dmesg -n 7
echo
for d in /sys/bus/pci/devices/*; do
    [ "$(cat $d/vendor):$(cat $d/device)" = "0x1234:0x11e8" ] && echo "edu détecté: ${d##*/}"
done
echo "Modules disponibles: $(ls /modules)"
if [ -x /autorun.sh ]; then
    /autorun.sh
    echo "=== FIN DU TEST (code $?)"
    poweroff -f
fi
echo "insmod /modules/pilote.ko | dmesg | tail | poweroff -f pour quitter"
exec setsid cttyhack sh
